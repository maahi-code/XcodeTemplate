<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Kind</key>
    <string>Xcode.IDEKit.TextSubstitutionFileTemplateKind</string>
    <key>Description</key>
    <string>A VIPER screen: View, Presenter, Interactor protocol and Router protocol, wired into an existing RIB.</string>
    <key>Summary</key>
    <string>View, Presenter, Interactor and Router for a screen inside a RIB</string>
    <key>Platforms</key>
    <array>
        <string>com.apple.platform.iphoneos</string>
    </array>
    <key>SortOrder</key>
    <integer>2</integer>
    <key>Destination</key>
    <string>Group</string>
    <key>FileGroup</key>
    <string>___VARIABLE_productName:identifier___</string>
    <key>Options</key>
    <array>
        <dict>
            <key>Identifier</key>
            <string>productName</string>
            <key>Required</key>
            <true/>
            <key>Name</key>
            <string>Screen Name:</string>
            <key>Description</key>
            <string>The screen name without "View", e.g. OnboardingIntro</string>
            <key>Type</key>
            <string>text</string>
            <key>Default</key>
            <string>ScreenName</string>
        </dict>
        <dict>
            <key>Identifier</key>
            <string>camelCasedProductName</string>
            <key>Required</key>
            <true/>
            <key>Name</key>
            <string>camelCased Screen Name:</string>
            <key>Description</key>
            <string>The screen name with the first letter lowercased, e.g. onboardingIntro</string>
            <key>Type</key>
            <string>text</string>
            <key>Default</key>
            <string>screenName</string>
        </dict>
        <dict>
            <key>Identifier</key>
            <string>coreName</string>
            <key>Required</key>
            <true/>
            <key>Name</key>
            <string>RIB Name:</string>
            <key>Description</key>
            <string>The RIB this screen belongs to. Its Interactor must provide GlobalInteractor, so use Core</string>
            <key>Type</key>
            <string>text</string>
            <key>Default</key>
            <string>Core</string>
        </dict>
    </array>
</dict>
</plist>
