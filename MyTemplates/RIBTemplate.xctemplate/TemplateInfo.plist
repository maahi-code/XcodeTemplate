<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Kind</key>
    <string>Xcode.IDEKit.TextSubstitutionFileTemplateKind</string>
    <key>Description</key>
    <string>A RIB: Builder, Interactor and Router.</string>
    <key>Summary</key>
    <string>Builder, Interactor and Router for a new RIB</string>
    <key>Platforms</key>
    <array>
        <string>com.apple.platform.iphoneos</string>
    </array>
    <key>SortOrder</key>
    <integer>1</integer>
    <key>Destination</key>
    <string>Group</string>
    <key>FileGroup</key>
    <string>___VARIABLE_productName:identifier___</string>
    <key>Options</key>
    <array>
        <dict>
            <key>Identifier</key>
            <string>productName</string>
            <key>Required</key>
            <true/>
            <key>Name</key>
            <string>RIB Name:</string>
            <key>Description</key>
            <string>The name of the RIB, e.g. Onb or Core</string>
            <key>Type</key>
            <string>text</string>
            <key>Default</key>
            <string>RIBName</string>
        </dict>
    </array>
</dict>
</plist>
